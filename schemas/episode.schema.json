{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joyzhzh/grounded-theory/schemas/episode.schema.json",
  "title": "Grounded Theory realization episode",
  "type": "object",
  "required": [
    "episode_id",
    "boundary_basis",
    "outcome_status",
    "source_refs"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "pattern": "^E[0-9]{3,}$"
    },
    "boundary_basis": {
      "enum": [
        "SOURCE_EXPLICIT",
        "RECONSTRUCTED",
        "UNCERTAIN"
      ],
      "description": "shared with the evidence vault; RECONSTRUCTED means a seat inferred the boundary rather than the source stating it"
    },
    "outcome_status": {
      "enum": [
        "ACCEPTED",
        "TRANSFORMED",
        "SUBSTITUTED",
        "DECOMPOSED",
        "POSTPONED",
        "ABANDONED",
        "UNKNOWN"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^MNF-[A-Z0-9-]+$"
      }
    },
    "note": {
      "type": "string"
    },
    "derived_from": {
      "type": "object",
      "description": "optional link to the vault package and descriptive episodes this analytical episode was reconstructed from",
      "required": [
        "package_id",
        "episode_ids"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "pattern": "^PKG-[A-Z0-9-]+$"
        },
        "episode_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EPI-[A-Z0-9-]+$"
          }
        }
      }
    }
  }
}
