{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joyzhzh/grounded-theory/schemas/sampling-request.schema.json",
  "title": "Grounded Theory theoretical-sampling request",
  "description": "The one request contract shared with the evidence vault (joyzhzh/aigc-chouka-evidence). A request proposes collection; it authorizes nothing. workflow_regimes uses the vault's TEMPORAL_REGIMES vocabulary verbatim.",
  "type": "object",
  "required": [
    "request_id",
    "provisional_focus",
    "focus_ids",
    "discriminating_question",
    "targets",
    "eligible_source_classes",
    "languages",
    "date_range",
    "creators",
    "workflow_regimes",
    "restrictions",
    "counter_search",
    "resource_ceiling",
    "stop_rule",
    "claim_ceiling",
    "required_return_fields",
    "status"
  ],
  "properties": {
    "request_id": {"type": "string", "pattern": "^REQ[0-9]{3,}$"},
    "provisional_focus": {"type": ["string", "null"], "minLength": 1, "description": "the provisional category or relationship the request tests; null only for an exploratory first cycle"},
    "focus_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(CAT|CMP)[0-9]{3,}$"}, "description": "packet categories or comparisons the focus rests on"},
    "discriminating_question": {"type": "string", "minLength": 1},
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["SUPPORT", "CONTRADICTION", "BOUNDARY", "RIVAL", "NEGATIVE_CASE"]}},
    "eligible_source_classes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"}},
    "date_range": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "to": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "creators": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "named creators, channels, or projects in scope; empty means unrestricted"},
    "workflow_regimes": {"type": "array", "uniqueItems": true, "items": {"enum": ["SEQUENTIAL_DECOMPOSED", "HYBRID_TRANSITION", "DIRECT_JOINT", "UNKNOWN_OR_INSUFFICIENT"]}, "description": "empty means any regime"},
    "restrictions": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "lawful-access, privacy, and model-processing constraints the collection must respect"},
    "counter_search": {"type": "string", "minLength": 1},
    "resource_ceiling": {"type": "string", "minLength": 1},
    "stop_rule": {"type": "string", "minLength": 1},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "required_return_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "empty means the vault's default package"},
    "status": {"enum": ["PROPOSED", "AUTHORIZED", "RETURNED", "CLOSED"]},
    "authority_ref": {"type": "string", "minLength": 1},
    "returned_package_id": {"type": "string", "pattern": "^PKG-[A-Z0-9-]+$"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["AUTHORIZED", "RETURNED", "CLOSED"]}}},
      "then": {"required": ["authority_ref"]}
    },
    {
      "if": {"properties": {"status": {"const": "RETURNED"}}},
      "then": {"required": ["returned_package_id"]}
    }
  ]
}
