{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joyzhzh/grounded-theory/schemas/category-memo.schema.json",
  "title": "Grounded Theory category memo",
  "type": "object",
  "required": ["memo_id", "category_id", "status", "definition", "not_this", "supporting_code_ids", "negative_case_ids", "rival_explanations"],
  "properties": {
    "memo_id": {"type": "string", "pattern": "^MEM[0-9]{3,}$"},
    "category_id": {"type": "string", "pattern": "^CAT[0-9]{3,}$"},
    "status": {"enum": ["SENSITIZING_ONLY", "EMERGING", "FOCUSED", "SUPERSEDED", "RETIRED"]},
    "definition": {"type": "string", "minLength": 1},
    "not_this": {"type": "string", "minLength": 1},
    "supporting_code_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CDE[0-9]{3,}$"}},
    "negative_case_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(I|E)[0-9]{3,}$"}},
    "rival_explanations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "supersedes": {"type": "string", "pattern": "^MEM[0-9]{3,}$"},
    "supersession_reason": {"type": "string", "minLength": 1},
    "retirement_reason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["EMERGING", "FOCUSED"]}}},
      "then": {"properties": {"supporting_code_ids": {"minItems": 1}}}
    },
    {"if": {"required": ["supersedes"]}, "then": {"required": ["supersession_reason"]}},
    {"if": {"properties": {"status": {"const": "RETIRED"}}}, "then": {"required": ["retirement_reason"]}}
  ]
}
